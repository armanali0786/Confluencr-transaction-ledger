{
  "info": {
    "name": "Ledger API",
    "description": "Accounts, immutable transactions and atomic transfers. Run the folders in order (or the whole collection with the Collection Runner); ids are captured into collection variables and references are timestamped so the collection can be re-run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "accountAId",
      "value": ""
    },
    {
      "key": "accountBId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "creditRef",
      "value": ""
    },
    {
      "key": "unknownId",
      "value": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('database is up', () => pm.expect(pm.response.json().data.database).to.eql('up'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create account A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Account A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const account = pm.response.json().data;",
                  "pm.test('starts at zero', () => pm.expect(account.balance).to.eql('0.00'));",
                  "pm.collectionVariables.set('accountAId', account.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create account B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Account B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('accountBId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create account - missing name (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code is VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has pagination meta', () => pm.expect(pm.response.json().meta).to.have.keys('current_page', 'page_size', 'total_records', 'total_pages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account A",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountAId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountAId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get unknown account (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{unknownId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{unknownId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code is ACCOUNT_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('ACCOUNT_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get malformed account id (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/not-a-uuid",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "not-a-uuid"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code is VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Credit account A 100",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountAId}}\",\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"reference_id\": \"{{creditRef}}\",\n  \"description\": \"Opening deposit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('creditRef', `DEP-${Date.now()}`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const { transaction, account } = pm.response.json().data;",
                  "pm.test('balance is 100.00', () => pm.expect(account.balance).to.eql('100.00'));",
                  "pm.collectionVariables.set('transactionId', transaction.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Debit account A 30",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountAId}}\",\n  \"type\": \"debit\",\n  \"amount\": \"30.00\",\n  \"reference_id\": \"INV-{{$timestamp}}\",\n  \"description\": \"Office supplies\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('balance is 70.00', () => pm.expect(pm.response.json().data.account.balance).to.eql('70.00'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate reference (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountAId}}\",\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"reference_id\": \"{{creditRef}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code is DUPLICATE_TRANSACTION', () => pm.expect(pm.response.json().error.code).to.eql('DUPLICATE_TRANSACTION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Debit above balance (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
