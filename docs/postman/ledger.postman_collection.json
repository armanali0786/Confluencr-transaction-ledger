                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const types = pm.response.json().data.map((t) => t.type);",
                  "pm.test('latest first', () => pm.expect(types.slice(0, 2)).to.eql(['debit', 'credit']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid pagination (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountAId}}/transactions?page=0&limit=500",
              "host": ["{{baseUrl}}"],
