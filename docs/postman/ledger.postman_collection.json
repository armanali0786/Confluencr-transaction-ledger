                ]
              }
            }
          ]
        },
        {
          "name": "Invalid amount (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountAId}}\",\n  \"type\": \"debit\",\n  \"amount\": 0,\n  \"reference_id\": \"ZERO-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code is VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Account A history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountAId}}/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountAId}}", "transactions"],
              "query": [
                {
                  "key": "page",
