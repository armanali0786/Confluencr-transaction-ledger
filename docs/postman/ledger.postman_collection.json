            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountAId}}\",\n  \"type\": \"debit\",\n  \"amount\": 1000,\n  \"reference_id\": \"BIG-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
