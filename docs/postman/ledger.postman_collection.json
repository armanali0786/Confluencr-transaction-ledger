    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer A → B 25.50",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountAId}}\",\n  \"to_account_id\": \"{{accountBId}}\",\n  \"amount\": \"25.50\",\n  \"reference_id\": \"TRF-{{$timestamp}}\",\n  \"description\": \"Rent share\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const { accounts, transactions, transfer } = pm.response.json().data;",
                  "pm.test('balances updated', () => { pm.expect(accounts.from.balance).to.eql('44.50'); pm.expect(accounts.to.balance).to.eql('25.50'); });",
                  "pm.test('ledger entries linked', () => { pm.expect(transactions.debit.transfer_id).to.eql(transfer.id); pm.expect(transactions.credit.transfer_id).to.eql(transfer.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Same-account transfer (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountAId}}\",\n  \"to_account_id\": \"{{accountAId}}\",\n  \"amount\": 1,\n  \"reference_id\": \"SELF-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code is SAME_ACCOUNT_TRANSFER', () => pm.expect(pm.response.json().error.code).to.eql('SAME_ACCOUNT_TRANSFER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer above balance (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
